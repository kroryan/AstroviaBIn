# AstroviaBin Main Application Configuration
# Copy this file to .env.local and configure as needed
# All feature settings are managed through the admin UI at /admin

# Application Server
# PORT=5000  # Optional: server listening port (defaults to 5000)

# Login (single admin account). Defaults to admin / admin — change it.
# ASTROVIABIN_ADMIN_USER=admin
# ASTROVIABIN_ADMIN_PASSWORD=admin
# ASTROVIABIN_SESSION_SECRET=  # optional; generated and stored next to the database when unset
# ASTROVIABIN_AUTH_DISABLED=false  # local development only

# Optional: PostgreSQL Database
# By default AstroviaBin uses a built-in SQLite database (no setup required).
# To use PostgreSQL instead, set DATABASE_URL to a connection string:
# DATABASE_URL=postgresql://astroviabin:password@localhost:5432/astroviabin

# Docker Compose variables (put these in a Compose .env file or the shell)
# POSTGRES_PASSWORD=your_secure_database_password_here
# ASTROVIABIN_PORT=5000  # Optional: external port mapping (defaults to 5000)
# ASTROVIABIN_HOST_DATA=/srv/astroviabin/AppData
# ASTROVIABIN_HOST_LIBRARY=/srv/astroviabin/Media
# FITS_HOST_LIBRARY=/srv/astroviabin/FITS/library
# FITS_HOST_DERIVATIVES=/srv/astroviabin/FITS/derivatives
# FITS_HOST_UPLOADS=/srv/astroviabin/FITS/uploads
# FITS_HOST_ANALYSIS=/srv/astroviabin/FITS/analysis

# Optional local FITS library. FITS files are indexed in the normal gallery,
# rendered and plate-solved locally; no photo/FITS is sent to Astrometry.net.
# FITS_LIBRARY_DIR=./data/fits
# FITS_DERIVATIVES_DIR=./data/fits-derived
# FITS_UPLOAD_DIR=./data/fits-upload
# FITS_ANALYSIS_DIR=./data/fits-analysis
# FITS_CACHE_DIR=./data/fits-cache
# FITS_MAX_PROCESS_BYTES=1073741824
# ASTROVIABIN_MAX_UPLOAD_BYTES=21474836480

# IMPORTANT SECURITY NOTES:
# 1. Never commit files containing real secrets to version control
# 2. Use .env.local for development (already gitignored)
# 3. For production, use environment variables or secret management systems
# 4. API keys should never be exposed to client-side code
# 5. Rotate your API keys regularly
