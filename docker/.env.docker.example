# Docker Compose Environment Variables
# Copy this file to .env in the project root (same directory as docker-compose.yml)
# and fill in your actual values

# Optional: Application configuration
ASTROVIABIN_PORT=5000
ENABLE_PLATE_SOLVING=true
PLATE_SOLVE_MAX_CONCURRENT=3

# Persistent local library and FITS analysis paths. Change these if your
# expansion disk is mounted elsewhere. Immich and remote Astrometry.net
# credentials are not required.
ASTROVIABIN_HOST_DATA=/srv/astroviabin/AppData
ASTROVIABIN_HOST_LIBRARY=/srv/astroviabin/Media
FITS_HOST_LIBRARY=/srv/astroviabin/FITS/library
FITS_HOST_DERIVATIVES=/srv/astroviabin/FITS/derivatives
FITS_HOST_UPLOADS=/srv/astroviabin/FITS/uploads
FITS_HOST_ANALYSIS=/srv/astroviabin/FITS/analysis

# Optional: PostgreSQL (only needed with docker-compose.postgres.yml)
# By default AstroviaBin uses a built-in SQLite database — no database setup required.
# To use PostgreSQL, layer the postgres override and set a password:
#   docker compose -f docker-compose.yml -f docker-compose.postgres.yml up -d --build
# POSTGRES_PASSWORD=your_secure_database_password_here

# SECURITY NOTES:
# 1. This file should be created as .env in the project root
# 2. Never commit the actual .env file to version control
# 3. Use strong, unique passwords
# 4. These can also be configured via the admin web interface after startup
