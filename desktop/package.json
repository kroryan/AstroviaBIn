{
  "name": "astroviabin-desktop",
  "productName": "AstroviaBin",
  "version": "0.12.1",
  "description": "AstroviaBin desktop server: system tray app that runs your private astrophotography library",
  "main": "src/main.js",
  "author": {
    "name": "AstroviaBin",
    "email": "astroviabin@users.noreply.github.com"
  },
  "homepage": "https://github.com/kroryan/AstroviaBIn",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "node --test src/config.test.cjs src/preflight.test.cjs",
    "start": "electron .",
    "stage:linux": "node scripts/stage.mjs linux",
    "stage:win": "node scripts/stage.mjs win",
    "dist:linux": "npm run stage:linux && electron-builder --linux deb --x64",
    "dist:win": "npm run stage:win && electron-builder --win nsis --x64 && node scripts/build-msix.mjs",
    "dist:win:msix": "node scripts/build-msix.mjs"
  },
  "devDependencies": {
    "electron": "43.7.7",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "io.github.kroryan.astroviabin",
    "productName": "AstroviaBin",
    "executableName": "astroviabin-desktop",
    "copyright": "AstroviaBin contributors (based on Sidereal). MIT License.",
    "directories": {
      "output": "out",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "package.json",
      "assets/icon.png",
      "assets/tray.png",
      "assets/tray.ico"
    ],
    "extraResources": [
      {
        "from": ".stage/${os}/",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "artifactName": "AstroviaBin-${version}-${arch}.${ext}",
    "linux": {
      "target": [
        "deb"
      ],
      "icon": "assets/icons",
      "category": "Science",
      "synopsis": "Private astrophotography library server (system tray)",
      "description": "AstroviaBin is a self-hosted library for astrophotography: photos and FITS, local plate solving with Astrometry.net, sky annotations, albums, stacking and HOTPANTS transient search. It runs as a small server managed from a system tray icon; use it in your web browser.",
      "maintainer": "AstroviaBin <astroviabin@users.noreply.github.com>",
      "vendor": "AstroviaBin",
      "desktop": {
        "entry": {
          "Name": "AstroviaBin",
          "Comment": "Private astrophotography library (server in the system tray)",
          "Keywords": "astronomy;astrophotography;FITS;plate solving;",
          "StartupWMClass": "AstroviaBin"
        }
      }
    },
    "deb": {
      "packageName": "astroviabin",
      "priority": "optional",
      "afterInstall": "packaging/after-install.sh",
      "afterRemove": "packaging/after-remove.sh",
      "fpm": [
        "--before-remove=packaging/before-remove.sh"
      ],
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2",
        "libgbm1",
        "astrometry.net",
        "libcfitsio10t64 | libcfitsio10"
      ],
      "recommends": [
        "astrometry-data-2mass-08-19"
      ],
      "compression": "xz"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AstroviaBin",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "packaging/installer.nsh",
      "artifactName": "AstroviaBin-Setup-${version}-x64.${ext}"
    },
    "appx": {
      "applicationId": "AstroviaBin",
      "identityName": "AstroviaBin",
      "publisher": "CN=AstroviaBin",
      "publisherDisplayName": "AstroviaBin contributors",
      "displayName": "AstroviaBin",
      "backgroundColor": "#05030c",
      "artifactName": "AstroviaBin-${version}-${arch}.${ext}",
      "electronUpdaterAware": false
    }
  }
}
